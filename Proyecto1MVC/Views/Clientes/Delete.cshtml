@model Proyecto1MVC.Models.GestionClientes

@{
    ViewData["Title"] = "Eliminar Cliente";
}

<h2>¿Está seguro de eliminar este cliente?</h2>

<div>
    <h4>@Model.Nombre @Model.PrimerApellido @Model.SegundoApellido</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">Tipo Identificación</dt>
        <dd class="col-sm-10">@Model.TipoIdentificacion</dd>

        <dt class="col-sm-2">Identificación</dt>
        <dd class="col-sm-10">@Model.ClienteIdentificacion</dd>

        <dt class="col-sm-2">Fecha Nacimiento</dt>
        <dd class="col-sm-10">@Model.FechaNacimiento.ToShortDateString()</dd>
    </dl>
</div>

<form asp-action="Delete">
    <input type="hidden" asp-for="ClienteIdentificacion" />
    <button type="submit" class="btn btn-danger">Eliminar</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>

