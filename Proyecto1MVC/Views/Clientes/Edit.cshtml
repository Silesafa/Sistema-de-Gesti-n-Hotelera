@model Proyecto1MVC.Models.GestionClientes

@{
    ViewData["Title"] = "Editar Cliente";
}

<h2>Editar Cliente</h2>

<form asp-action="Edit" method="post">
   

    <div class="form-group">
        <label asp-for="TipoIdentificacion">Tipo de Identificación</label>
        <select asp-for="TipoIdentificacion" class="form-control" id="TipoIdentificacion">
            <option value="Cedula">Cédula</option>
            <option value="DIMEX">DIMEX</option>
            <option value="Pasaporte">Pasaporte</option>
        </select>
    </div>

    <div class="form-group">
        <label asp-for="ClienteIdentificacion">Identificación</label>
        <input asp-for="ClienteIdentificacion" class="form-control" id="ClienteIdentificacion" />
        <span asp-validation-for="ClienteIdentificacion" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Nombre"></label>
        <input asp-for="Nombre" class="form-control" />
        <span asp-validation-for="Nombre" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="PrimerApellido"></label>
        <input asp-for="PrimerApellido" class="form-control" />
        <span asp-validation-for="PrimerApellido" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="SegundoApellido"></label>
        <input asp-for="SegundoApellido" class="form-control" />
        <span asp-validation-for="SegundoApellido" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="FechaNacimiento"></label>
        <input asp-for="FechaNacimiento" type="date" class="form-control" />
        <span asp-validation-for="FechaNacimiento" class="text-danger"></span>
    </div>



    <button type="submit" class="btn btn-primary">Guardar</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        document.getElementById("TipoIdentificacion").addEventListener("change", function () {
            var tipo = this.value;
            var input = document.getElementById("ClienteIdentificacion");

            if (tipo === "Cedula") {
                input.placeholder = "Ej: 1-1111-0909";
                input.maxLength = 11;
            } else if (tipo === "DIMEX") {
                input.placeholder = "12 dígitos numéricos";
                input.maxLength = 12;
            } else if (tipo === "Pasaporte") {
                input.placeholder = "Alfanumérico (1-50 caracteres)";
                input.maxLength = 50;
            }
        });
    </script>
}
