@model Proyecto1MVC.Models.GestionEmpleados

@{
    ViewData["Title"] = "Eliminar Empleado";
}

<h2>Eliminar Empleado</h2>

<h3>¿Está seguro que desea eliminar este empleado?</h3>

<div>
    <dl class="row">
        <dt class="col-sm-2">Identificación</dt>
        <dd class="col-sm-10">@Model.EmpleadoIdentificacion</dd>

        <dt class="col-sm-2">Nombre</dt>
        <dd class="col-sm-10">@Model.Nombre</dd>

        <dt class="col-sm-2">Primer Apellido</dt>
        <dd class="col-sm-10">@Model.PrimerApellido</dd>

        <dt class="col-sm-2">Segundo Apellido</dt>
        <dd class="col-sm-10">@Model.SegundoApellido</dd>

        <dt class="col-sm-2">Fecha Nacimiento</dt>
        <dd class="col-sm-10">@Model.FechaNacimiento.ToShortDateString()</dd>

        <dt class="col-sm-2">Fecha Ingreso</dt>
        <dd class="col-sm-10">@Model.FechaIngreso.ToShortDateString()</dd>

        <dt class="col-sm-2">Categoría</dt>
        <dd class="col-sm-10">@Model.Categoria</dd>

        <dt class="col-sm-2">Salario</dt>
        <dd class="col-sm-10">₡@Model.Salario.ToString("N2")</dd>

        <dt class="col-sm-2">Provincia</dt>
        <dd class="col-sm-10">@Model.Provincia</dd>

        <dt class="col-sm-2">Cantón</dt>
        <dd class="col-sm-10">@Model.Canton</dd>

        <dt class="col-sm-2">Distrito</dt>
        <dd class="col-sm-10">@Model.Distrito</dd>

        <dt class="col-sm-2">Dirección Exacta</dt>
        <dd class="col-sm-10">@Model.DireccionExacta</dd>
    </dl>
</div>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="EmpleadoIdentificacion" />
    <div class="btn-group" role="group">
        <button type="submit" class="btn btn-danger">Eliminar</button>
        <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
    </div>
</form>


