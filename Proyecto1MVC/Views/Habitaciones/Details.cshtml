@model Proyecto1MVC.Models.GestionHabitaciones

@{
    ViewData["Title"] = "Detalles de Habitación";
}

<h2>@ViewData["Title"]</h2>

<div class="card">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">Número</dt>
            <dd class="col-sm-9">@Model.NumeroHabitacion</dd>

            <dt class="col-sm-3">Tipo</dt>
            <dd class="col-sm-9">@Model.TipoHabitacion</dd>

            <dt class="col-sm-3">Tarifa por Noche</dt>
            <dt class="col-sm-9">@Model.TarifaPorNoche.ToString("C", new System.Globalization.CultureInfo("en-US"))</dt>

            <dt class="col-sm-3">TV Satelital</dt>
            <dd class="col-sm-9">@((Model.TVSatelital) ? "Sí" : "No")</dd>

            <dt class="col-sm-3">Pendientes Mantenimiento</dt>
            <dd class="col-sm-9">@Model.PendientesMantenimiento</dd>
        </dl>
    </div>
</div>

<div class="mt-3">
    <a asp-action="Edit" asp-route-numero="@Model.NumeroHabitacion" class="btn btn-warning">Editar</a>
    <a asp-action="Delete" asp-route-numero="@Model.NumeroHabitacion" class="btn btn-danger">Eliminar</a>
    <a asp-action="Index" class="btn btn-secondary">Volver a la lista</a>
</div>
