@model Proyecto1MVC.Models.GestionReservaciones

@{
    ViewData["Title"] = "Eliminar Reservación";
}

<h2>¿Está seguro que desea eliminar esta reservación?</h2>

<div>
    <dl class="row">
        <dt class="col-sm-2">Código</dt>
        <dd class="col-sm-10">@Model.CodigoReservacion</dd>

        <dt class="col-sm-2">Cliente</dt>
        <dd class="col-sm-10">@Model.ClienteIdentificacion</dd>

        <dt class="col-sm-2">Habitación</dt>
        <dd class="col-sm-10">@Model.NumeroHabitacion</dd>

        <dt class="col-sm-2">Fecha Ingreso</dt>
        <dd class="col-sm-10">@Model.FechaIngreso.ToString("dd/MM/yyyy")</dd>

        <dt class="col-sm-2">Fecha Salida</dt>
        <dd class="col-sm-10">@Model.FechaSalida.ToString("dd/MM/yyyy")</dd>
    </dl>
</div>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="CodigoReservacion" />
    <button type="submit" class="btn btn-danger">Eliminar</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>




